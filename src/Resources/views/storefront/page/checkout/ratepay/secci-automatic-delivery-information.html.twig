{# @var error bool #}
{# @var secciPaymentMethods \Shopware\Core\Checkout\Payment\PaymentMethodCollection #}

{% set additionalClass = '' %}
{% if error %}
    {% set additionalClass = ' ratepay--secci_banner--error' %}
{% endif %}

{% block ratepay_secci_banner %}
    <div class="col-sm-12">
        <div class="ratepay--secci_banner ratepay--secci_variant1{{ additionalClass }}">
            <div class="ratepay--secci_banner--container">
                <div class="ratepay--secci_banner--icon">
                    <div class="ratepay--secci_banner--icon_info">
                        {% sw_icon 'info' style {
                            color: 'info'
                        } %}
                    </div>
                    <div class="ratepay--secci_banner--icon_error">
                        {% sw_icon 'info' style {
                            color: 'danger'
                        } %}
                    </div>
                </div>

                <div class="ratepay--secci_banner--text_container">
                    <div class="ratepay--secci_banner--text_initial">
                        <div class="ratepay--secci_banner--headline">
                            {{ 'ratepay.storefront.checkout.secci.header'|trans }}
                        </div>

                        <p class="ratepay--secci_banner--text">
                            {% set paymentMethodsString = '' %}
                            {# @var paymentMethod \Shopware\Core\Checkout\Payment\PaymentMethodEntity #}
                            {% for paymentMethod in secciPaymentMethods %}
                                {% if not loop.first %}
                                    {% if loop.last %}
                                        {% set paymentMethodsString = paymentMethodsString ~ ('ratepay.storefront.checkout.secci.paymentMethodsJoiner.or.last'|trans) %}
                                    {% else %}
                                        {% set paymentMethodsString = paymentMethodsString ~ ('ratepay.storefront.checkout.secci.paymentMethodsJoiner.or.firstFew'|trans) %}
                                    {% endif %}
                                {% endif %}
                                {% set paymentMethodsString = paymentMethodsString ~ paymentMethod.translated.name %}
                            {% endfor %}

                            {{ "ratepay.storefront.checkout.secci.variant1.text"|trans({
                                '%paymentMethods%': paymentMethodsString,
                                '%email%': context.customer.email
                            }) }}
                        </p>

                        <span class="ratepay--secci_banner--show_more_button"
                              data-bs-toggle="collapse"
                              data-bs-target="#ratepayMoreText"
                              role="button"
                              aria-expanded="false"
                              aria-controls="ratepayMoreText">
                            {{ 'ratepay.storefront.checkout.secci.learnMore'|trans }}
                            {% sw_icon 'arrow-up' style {
                                color: 'primary',
                                pack:'solid'
                            } %}
                            {% sw_icon 'arrow-down' style {
                                color: 'primary',
                                pack:'solid'
                            } %}
                        </span>

                        <p id="ratepayMoreText"
                           class="ratepay--secci_banner--more_text collapse">
                            {% set paymentMethodsString = '' %}
                            {# @var paymentMethod \Shopware\Core\Checkout\Payment\PaymentMethodEntity #}
                            {% for paymentMethod in secciPaymentMethods %}
                                {% if not loop.first %}
                                    {% if loop.last %}
                                        {% set paymentMethodsString = paymentMethodsString ~ ('ratepay.storefront.checkout.secci.paymentMethodsJoiner.and.last'|trans) %}
                                    {% else %}
                                        {% set paymentMethodsString = paymentMethodsString ~ ('ratepay.storefront.checkout.secci.paymentMethodsJoiner.and.firstFew'|trans) %}
                                    {% endif %}
                                {% endif %}
                                {% set paymentMethodsString = paymentMethodsString ~ paymentMethod.translated.name %}
                            {% endfor %}

                            {{ "ratepay.storefront.checkout.secci.variant1.explanation"|trans({
                                '%paymentMethods%': paymentMethodsString,
                            }) }}
                        </p>
                    </div>
                </div>

                <div class="ratepay--secci_banner--spacer" aria-hidden="true"></div>
            </div>
        </div>
    </div>
{% endblock %}
