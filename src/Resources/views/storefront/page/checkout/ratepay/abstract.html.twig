{% block ratepay_checkout_sandbox_info %}
    {% if (page.extensions.ratepay.isSandbox) %}
        {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
            type: "warning",
            content: "ratepay.storefront.checkout.hints.sandboxInfo"|trans
        } %}
    {% endif %}
{% endblock %}

{% block ratepay_checkout_fields %}
    {% if (page.extensions.ratepay.company) %}
        {#% if page.extensions.ratepay.vatId is null %#}
            {% sw_include '@RatepayPaments/storefront/page/checkout/ratepay/common/vatid.html.twig' %}
        {#% endif %#}
    {% else %}
        {#% if page.extensions.ratepay.birthday is null %#}
            {% sw_include '@RatepayPaments/storefront/page/checkout/ratepay/common/birthday.html.twig' %}
        {#% endif %#}
    {% endif %}
    {#% if page.extensions.ratepay.phoneNumber is null %#}
        {% sw_include '@RatepayPaments/storefront/page/checkout/ratepay/common/phone.html.twig' %}
    {#% endif %#}
{% endblock %}

{% if page.extensions.ratepay.showSecciDeliveryConfirmation %}
    <div class="col-sm-12">
        <div class="ratepay--secci_banner ratepay--secci_variant1 ratepay--secci_banner--mailed"
             data-ratepay-secci="true"
             data-ratepay-secci-error-url="{{ path('frontend.checkout.confirm.page') }}"
             data-ratepay-secci-action="{{ path('frontend.checkout.ratepay.secci') }}">
            <div class="ratepay--secci_banner--container">
                <div class="ratepay--secci_banner--icon">
                    <div class="ratepay--secci_banner--icon_success">
                        {% sw_icon 'checkmark-circle' %}
                    </div>
                </div>
                <div class="ratepay--secci_banner--text_container">
                    <div class="ratepay--secci_banner--text_mailed">
                        <div class="ratepay--secci_banner--headline">
                            {{ 'ratepay.storefront.checkout.secci.deliveredByMail.header'|trans }}
                        </div>
                        <p class="ratepay--secci_banner--text">
                            {{ 'ratepay.storefront.checkout.secci.variant1.confirmation'|trans({
                                '%email%': context.customer.email
                            }) }}
                        </p>
                        {% block ratepay_secci_banner_confirmation_pdf_button %}
                            <span class="ratepay--secci_banner--confirmation_pdf_button"
                                  data-ratepay-secci-delivery-type="pdf">
                                {{ 'ratepay.storefront.checkout.secci.variant1.downloadPdf'|trans }}
                            </span>
                        {% endblock %}
                    </div>
                </div>
                <div class="ratepay--secci_banner--spacer" aria-hidden="true"></div>
            </div>
        </div>
    </div>
{% endif %}

{% if page.extensions.ratepay.showSecciBanner and (page.extensions.ratepay.secciVariant == 2 or page.extensions.ratepay.secciVariant == 3) %}
    {% block ratepay_secci_banner_variant2 %}
        {% sw_include '@RatepayPaments/storefront/page/checkout/ratepay/secci-banner.html.twig' with {
            variant: page.extensions.ratepay.secciVariant,
            error: formViolations.violations('/ratepay/secci') is not empty,
            secciPaymentMethods: page.extensions.ratepay.secciPaymentMethods,
        } %}
    {% endblock %}
{% endif %}

{% block ratepay_legal_textes %}
    <div class="form-row row">
        <div class="form-group col-sm-12">
            {{ "ratepay.storefront.checkout.hints.legalText"|trans|raw }}
        </div>
    </div>
{% endblock %}
