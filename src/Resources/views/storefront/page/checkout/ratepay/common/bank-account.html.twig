{% block ratepay_personal_data_bank_account %}

    {% block ratepay_personal_data_bank_account_title %}
        <div class="form-row">
            <div class="form-group col-sm-12">
                <label class="form-label">
                    <strong>{{ "document.bankAccount"|trans|sw_sanitize }}</strong>
                </label>
            </div>
        </div>
    {% endblock %}

    {% block ratepay_personal_data_bank_account_fields %}
        <div class="form-row">
            <div class="form-group col-sm-4">
                <label class="form-label" for="rp-iban-account-holder">
                    <strong>{{ "ratepay.storefront.checkout.fields.accountHolder"|trans|sw_sanitize }}{{ "general.required"|trans|sw_sanitize }}</strong>
                </label>
                {% if ratepay.accountHolders|length == 1 %}
                    <input type="text"
                           class="form-control{% if formViolations.getViolations('/ratepay/bankData/accountHolder') is not empty %} is-invalid{% endif %}"
                           id="rp-iban-account-holder"
                           placeholder="{{ "ratepay.storefront.checkout.fields.accountHolder"|trans|sw_sanitize }}"
                           value="{{ ratepay.accountHolders[0] }}"
                           name="ratepay[bankData][accountHolder]"
                           form="confirmOrderForm"
                           readonly
                           required="required"
                    >
                {% else %}
                    <select class="form-control{% if formViolations.getViolations('/ratepay/bankData/accountHolder') is not empty %} is-invalid{% endif %}"
                           id="rp-iban-account-holder"
                           name="ratepay[bankData][accountHolder]"
                           form="confirmOrderForm"
                           required="required"
                    >
                        {% for name in ratepay.accountHolders %}
                            <option value="{{ name }}">{{ name }}</option>
                        {% endfor %}
                    </select>
                {% endif %}
            </div>
            <div class="form-group col-sm-4">
                <label class="form-label" for="rp-iban-account-number">
                    <strong>{{ "ratepay.storefront.checkout.fields.iban"|trans|sw_sanitize }}{{ "general.required"|trans|sw_sanitize }}</strong>
                </label>
                <input
                    type="text"
                    class="form-control{% if formViolations.getViolations('/ratepay/bankData/iban') is not empty %} is-invalid{% endif %}"
                    id="rp-iban-account-number"
                    placeholder="{{ "ratepay.storefront.checkout.fields.iban"|trans|sw_sanitize }}"
                    name="ratepay[bankData][iban]"
                    form="confirmOrderForm"
                    required="required"
                >
            </div>
        </div>
    {% endblock %}

    {% block ratepay_personal_data_bank_account_explanation %}
        <div class="ratepay-sepa-explanation-wrapper accordion" id="ratepaySepaExplanationAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="ratepaySepaExplanationAccordionHeader">
                    <button class="accordion-button collapsed fw-medium" type="button" data-bs-toggle="collapse" data-bs-target="#ratepaySepaExplanationAccordionBody" aria-expanded="false" aria-controls="ratepaySepaExplanationAccordionBody">
                        {{ "ratepay.storefront.checkout.hints.sepaExplanationToggle"|trans }}
                    </button>
                </h2>
                <div id="ratepaySepaExplanationAccordionBody" class="accordion-collapse collapse" aria-labelledby="ratepaySepaExplanationAccordionHeader" data-bs-parent="#ratepaySepaExplanationAccordion">
                    <div class="accordion-body">
                        {% sw_include '@RpayPayments/storefront/page/checkout/ratepay/common/sepa-legal.html.twig' %}
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}

{% endblock %}
