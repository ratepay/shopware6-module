{% sw_extends '@Storefront/storefront/page/checkout/confirm/index.html.twig' %}

{% block page_checkout_confirm_payment %}
    {% if page.extensions.ratepay.showSecciBanner and page.extensions.ratepay.secciVariant == 1 %}
        {% block ratepay_secci_banner_variant1 %}
            {% sw_include '@RatepayPaments/storefront/page/checkout/ratepay/secci-banner.html.twig' with {
                variant: 1,
                error: formViolations.violations('/ratepay/secci') is not empty,
                secciPaymentMethods: page.extensions.ratepay.secciPaymentMethods,
            } %}
        {% endblock %}
    {% endif %}

    {{ parent() }}
{% endblock %}

{% block page_checkout_confirm_product_table %}
    {% if (page.extensions.ratepay.enableBillingForm) %}
        <div class="ratepay--billing-form">
            <div class="row">
                <div class="col-md-12">
                    <div class="card checkout-card">
                        <div class="card-body">
                            <div class="card-title">
                                {{ context.paymentMethod.translated.name }}
                            </div>
                            <div class="card-body">
                                {% block ratepay_payment_fields %}
                                    {% sw_include '@RatepayPaments/storefront/page/checkout/ratepay/'~page.extensions.ratepay.paymentMethod~'.html.twig' %}
                                {% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% if page.extensions.ratepay.dfp %}
            <input type="hidden" name="ratepay[deviceIdentToken]"
                   value="{{ page.extensions.ratepay.dfp.deviceIdentToken }}" form="confirmOrderForm"/>
            {% if app.session.get('twig-ratepay-dfp') != page.extensions.ratepay.dfp.deviceIdentToken %}
                {{ app.session.set('twig-ratepay-dfp', page.extensions.ratepay.dfp.deviceIdentToken) }}
                {# SECCI banner Variant 2 and 3 are included in /views/storefront/page/checkout/ratepay/abstract.html.twig  #}
                {{ page.extensions.ratepay.dfp.html|raw }}
            {% endif %}
        {% endif %}
    {% elseif page.extensions.ratepay.showSecciBanner and (page.extensions.ratepay.secciVariant == 2 or page.extensions.ratepay.secciVariant == 3) %}
        {% block ratepay_secci_banner_variant2 %}
            {% sw_include '@RatepayPaments/storefront/page/checkout/ratepay/secci-banner.html.twig' with {
                variant: page.extensions.ratepay.secciVariant,
                error: formViolations.violations('/ratepay/secci') is not empty,
                secciPaymentMethods: page.extensions.ratepay.secciPaymentMethods,
            } %}
        {% endblock %}
    {% endif %}

    {{ parent() }}
{% endblock %}
